APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=shree_vinayak
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
# config/session.php defaults this to true automatically whenever APP_ENV=production below, so
# it's safe to leave unset. Left commented out (not "=true") because this file also doubles as
# the local-dev template (APP_ENV=local) — a live "true" here would break session cookies over
# plain http://localhost. Only uncomment if you need to force it on somewhere that isn't plain
# production (e.g. a staging box already behind HTTPS).
# SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

TWOFACTOR_API_KEY=
TWOFACTOR_OTP_TEMPLATE=OTP1

OTP_DEV_MODE=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# WhatsApp order/marketing notifications via AiSensy — see config/services.php. Each
# AISENSY_CAMPAIGN_* value must match a campaign name (= approved template) from the AiSensy
# dashboard; leaving one blank just skips that event. Also requires the matching toggle turned on
# in Admin -> Configuration (both a master switch and one switch per event).
AISENSY_API_KEY=
AISENSY_BASE_URL=https://backend.aisensy.com/campaign/t1/api/v2
AISENSY_CAMPAIGN_ORDER_CONFIRMED=
AISENSY_CAMPAIGN_OUT_FOR_DELIVERY=
AISENSY_CAMPAIGN_DELIVERED=
AISENSY_CAMPAIGN_CANCELLED=
AISENSY_CAMPAIGN_ABANDONED_CART=

# only fill these in for a template that actually has an image/document header — leave blank
# otherwise (see config/services.php)
AISENSY_MEDIA_ORDER_CONFIRMED=
AISENSY_MEDIA_OUT_FOR_DELIVERY=
AISENSY_MEDIA_DELIVERED=
AISENSY_MEDIA_CANCELLED=
AISENSY_MEDIA_ABANDONED_CART=

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
